{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],

    // vite bundles the client, so client.ts is an ordinary module: xterm is
    // imported rather than found on window, and esbuild does the emit. This
    // config only type-checks it.
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,

    "types": ["vite/client"],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": ["web/client.ts", "vite.config.ts", "types/**/*.d.ts"]
}
