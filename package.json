{
  "name": "c2c-conv",
  "version": "0.3.2",
  "description": "Share one Claude Code session with a second person, live",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "bin": {
    "c2c": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && chmod +x dist/src/cli.js dist/bigtop/server.js",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "pnpm run build && node --test \"dist/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@xterm/xterm": "5.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "license": "MIT",
  "private": true
}
